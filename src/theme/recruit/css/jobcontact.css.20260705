.mypageSide {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 2000;
    padding: 2rem 0 12rem;
    border-right: 1px solid #eaeded;
    width: 25rem;
    height: 100%;
    overflow: auto;
    background: #fff;
    transition-duration: .5s
}

.mypageSide__logo {
    border-bottom: 1px solid #eaeded;
    height: 8rem
}

.mypageSideInfo {
    padding: 3rem 3rem 0
}

.mypageSideInfo__img {
    border-radius: 50%;
    width: 5rem;
    height: 5rem;
    overflow: hidden
}

.mypageSideInfo__img img {
    width: 100%
}

.mypageSideInfo__text {
