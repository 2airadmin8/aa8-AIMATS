    cursor: pointer
}

.formError .formErrorContent, .formErrorOriginal .formErrorContent {
    position: relative;
    z-index: 991;
    padding: .5rem 1rem;
    border-radius: .5rem;
    width: 100%;
    min-width: 120px;
    font-size: 1rem;
    color: #fff;
