    font-size: 1.8rem;
    font-weight: 500
}

.contactTime {
    line-height: 1;
    white-space: nowrap
}

.contactTime + .contactTime {
    margin: 1rem 0 0
}

.contactTime__head {
    font-size: 1.3rem;
    font-weight: 700
}

.contactTime__date, .contactTime__time {
    position: relative;
    margin: 0 1.5rem;
    width: 22rem
}

.contactTime__input {
    padding: 1rem 2rem 1rem 4rem!important;
    border: 1px solid #d2d7e1!important;;
    border-radius: 12px!important;;
    width: 100%!important;;
    line-height: 1!important;;
    background-color: #fafafa!important;;
