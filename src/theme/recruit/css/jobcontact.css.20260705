    border-radius: 1rem;
    overflow: hidden;
    color: inherit;
    background-color: #ff64a6;
    background-image: url(../img/top_camp_bg.png);
    background-repeat: no-repeat;
    background-position: 50%;
    background-size: 110% auto;
    box-shadow: 0 0 1rem rgba(0, 0, 0, .1)
}

.topCamp__frame:hover {
    opacity: .8
}

.topCamp__frame--unlink {
    padding-bottom: 1rem
}

.topCamp__frame--unlink:hover {
