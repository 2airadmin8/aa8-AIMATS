}

.topSearch__clear {
    margin: 2rem 0 0
}

.topSearch__clearBtn {
    border: 0;
    font-size: 1.4rem;
    line-height: 1;
    color: #707070;
    text-decoration: underline;
    background: 0
}

.topSearch__clearBtn:hover {
    color: #fc549c
}

.topSearchInput {
    position: relative;
    padding: 0 0 0 3rem;
    border: 1px solid #d2d7e1;
    border-radius: 1rem;
    width: 40rem;
    overflow: hidden;
    background: #fafafa
}

.topSearchInput__icon {
    position: absolute;
    top: 50%;
    left: 1.5rem;
    z-index: 2;
    font-size: 1.4rem;
    color: #d4d4d4;
    transform: translateY(-50%)
}

.topSearchInput__form {
    padding: 0;
    border: 0;
    width: 100%;
    height: 5rem;
    font-size: 1.4rem;
    background: #fafafa
}

.topNew {
    padding: 4rem 0 6rem
}

.topNew--job {
    padding: 0
}

.topNew__blank {
    margin: 4rem 0 0;
    font-size: 1.6rem;
    text-align: center
}

.topNew__slide {
    position: relative;
    margin: 4rem 0 0
}

.topNew__item {
    padding: 1rem;
    font-feature-settings: "palt"
}

.topNew__link {
    display: block;
    position: relative;
    z-index: 1;
    border-radius: 1rem;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 1rem rgba(0, 0, 0, .1)
}

.topNew__link:hover {
    opacity: .8
}

.topNew__data {
    box-sizing: border-box;
    padding: 1rem 2.7rem .5rem;
    width: 100%;
    color: #383838
}

.topNew__img img {
    width: 100%
}

.topNew__title {
    margin: 0 0 1rem;
    min-height: 5rem;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.5;
    color: #2e49ed
}

.topNew__line {
    padding: 0 .5rem;
    font-size: 1.4rem;
    line-height: 1.5
}

.topNew__icon {
    width: 2.5rem;
    font-size: 1.4rem;
    color: #969595;
    text-align: center
}

.topNew__icon--marker {
    font-size: 1.8rem
}

.topNew__text {
    padding: 0 0 0 .5rem;
    width: calc(100% - 2.5rem)
}

.topNew__top {
    padding: 0 0 1rem
}

.topNew__company {
    padding: 1rem .5rem;
    border-top: 1px solid #d9dbdb;
    font-size: 1.4rem;
    line-height: 1
}

.topNew__chip {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    padding: 4rem 0 .5rem;
    width: 10rem;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1;
    color: #fff;
    text-align: center;
    background: #fc549c;
    transform: rotate(-45deg) translate(-1.5rem, -4.5rem) scale(.8)
}

.topNew__chip--close {
    background: #727272
}

.topNew .swiper-button {
    position: absolute;
    top: 50%;
    z-index: 2;
    font-size: 3rem;
    line-height: 1;
    color: #2e49ed;
    background: none;
    outline: 0;
    transition-duration: .5s;
    transform: translateY(-50%);
    cursor: pointer
}

.topNew .swiper-button i {
    line-height: 1
}

.topNew .swiper-button:after {
    display: none
}

.topNew .swiper-button-prev {
    left: -4rem
}

.topNew .swiper-button-next {
    right: -4rem
}

.topNew .swiper-button.swiper-button-disabled {
    opacity: 0
}

.topStep {
    padding: 6.5rem 0;
    background: #e7ebff
}

.topStep__box {
    position: relative;
    margin: 3.8rem 0 0;
    padding: 4rem 4.5rem 3rem;
    border: 2px solid #f0f0f0;
    border-radius: 1rem;
    overflow: hidden;
    text-align: center;
    background: #fff;
    box-shadow: 0 0 1rem rgba(0, 0, 0, .1)
}

.topStep__bar {
    position: absolute;
    top: 9.5rem;
    left: 0;
    width: 100%;
    height: 3px;
    background: #2e49ed
}

.topStep__item {
    max-width: 18%
}

.topStep__item:first-child .topStep__point:before, .topStep__item:last-child .topStep__point:before {
    display: block;
    position: absolute;
    top: 0;
    width: 20rem;
    height: 1rem;
    background: #fff;
    content: ""
}

.topStep__item:first-child .topStep__point:before {
    right: 100%
}

.topStep__item:last-child .topStep__point:before {
    left: 100%
}

.topStep__no {
    font-size: 2.9rem;
    font-weight: 700;
    line-height: 1;
    color: #b3b9dd
}

.topStep__point {
    position: relative;
    margin: 2rem auto 0;
    border-radius: 50%;
    width: 1.5rem;
    height: 1.5rem;
    background: #2e49ed
}

.topStep__img {
    margin: 2.2rem 0 0
}

.topStep__head {
    margin: 1.5rem 0 0;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1
}

.topStep__text {
    margin: 1rem 0 0;
    font-size: 1.2rem
}

.topSup {
    padding: 6.5rem 0
}

.topSup__list {
    margin: -.5rem 0 0
}

.topSup__item {
