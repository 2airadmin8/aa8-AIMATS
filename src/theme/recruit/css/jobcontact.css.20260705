.fixContact {
    position: fixed;
    top: 50%;
    right: 3rem;
    z-index: 3001;
    padding: 4rem 2.8rem 2.8rem;
    border-radius: 1rem;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 1rem rgba(0, 0, 0, .1);
    transition-duration: .2s
}

.fixContact:not(.active) {
    right: 1rem;
    padding: 0;
    border-radius: 50%;
    width: 6rem;
    height: 6rem;
    background: #2e49ed
}

.fixContact:not(.active) .fixContact__toggle {
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    color: #fff
}

.fixContact:not(.active) .fixContact__toggle--on {
    display: none
}

.fixContact:not(.active) .fixContact__frame {
    width: 0;
    height: 0;
    overflow: hidden
}

.fixContact.active .fixContact__toggle--off {
    display: none
}

.fixContact__icon {
    pointer-events: none
}

.fixContact__toggle {
    position: absolute;
    top: 1.5rem;
    right: 1rem;
    z-index: 2;
    width: 3rem;
    text-align: center;
    cursor: pointer
}

.fixContact__title {
    padding: 0 1rem;
    font-size: 1.5rem;
    font-weight: 500
}

.fixContact__ef {
    color: #fc549c
}

.fixContact__link {
    margin: 2.3rem 0 0
}

.fixContact__link--job {
    margin: 0
}

.fixContact__btn {
    height: 4.5rem
}

.fixContact__btn + .fixContact__btn {
    margin: .8rem 0 0
}

.fixContact__heart {
    margin: 0 1rem 0 0;
    font-size: 1.3rem
}

.scroll {
    overflow: auto;
    scrollbar-color: #c4c4c4 #f3f3f3
}

.scroll::-webkit-scrollbar {
    width: 10px;
    height: 10px;
    cursor: default
}

.scroll::-webkit-scrollbar-track {
    background: #f3f3f3
}

.scroll::-webkit-scrollbar-thumb {
    border-radius: 1rem;
    background: #c4c4c4
}

.modal {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 50000;
    width: calc(100% - 2rem);
    max-width: 98rem;
    transition-duration: .1s;
    pointer-events: none
}

.modal--dialog {
    z-index: 70000
}

.modal:not(.active) {
    display: none;
    opacity: 0;
    visibility: hidden
}

.modal__footer, .modal__header {
    width: 100%;
    background: #fff
}

.modal__header {
    border-bottom: 1px solid #d2d7e1;
    border-radius: 1rem 1rem 0 0
}

.modal__footer {
    border-top: 1px solid #d2d7e1;
    border-radius: 0 0 1rem 1rem
}

.modal__frame {
    transform: translate(-50%, -50%)
}

.modal__closeBG, .modal__frame {
    width: 100%;
    pointer-events: auto
}

.modal__closeBG {
    position: fixed;
    top: 0;
    left: 0;
    z-index: -1;
    height: 100%;
    opacity: 0;
    cursor: pointer
}

.modal__close {
    padding: 1rem;
    cursor: pointer
}

.modal__close-btn {
    border: 0;
    background: 0
}

.modal__close-icon {
    font-size: 3rem;
    line-height: 1;
    color: #fff;
    pointer-events: none
}

.modal__box {
    position: relative;
    background: #fff;
    pointer-events: auto
}

.modal__title {
    padding: 0 3rem;
    height: 6rem;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1
}

.modalData {
    padding: 1rem .5rem
}

.modalData__clear {
    margin: 0 0 0 2rem;
    border: 0;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1;
    color: #b0b0b0;
    background: 0;
    cursor: pointer
}

.modalData__clear:hover {
    color: #fe6565
}

.modalData__hit {
    font-size: 1.4rem;
    font-weight: 700;
    color: #727272
}

.modalData__hit:not(.active), .modalData__hitValue:not(.active) {
    display: none
}

.modalData__val {
    padding: 0 .5rem;
    font-size: 1.8rem
}

.modalData__btn {
    margin: 0 0 0 2rem;
    width: 16rem;
    height: 5rem;
    font-size: 1.4rem;
    font-weight: 700
}

.dialog {
    margin: 0 auto;
    padding: 5rem 5rem 7rem;
    border-radius: 1rem;
    max-width: 72rem;
    background: #fff
}

.dialog__text {
    font-size: 2rem;
    font-weight: 700;
    line-height: 2;
    color: #535353;
    text-align: center
}

.dialog__list {
    margin: 3rem 0 0
}

.dialog__btn {
    width: 49%;
    height: 7rem;
    font-weight: 500
}

.modalToggle {
    background: #fff
}

.modalToggle__btn {
    border: 0;
    border-bottom: 1px solid #e7ebff;
    width: 50%;
    height: 5rem;
    cursor: pointer
}

.modalToggle__btn.active {
    border-color: #2e49ed;
    color: #fff;
    background: #2e49ed
}

.modalToggle__btn.active .modalToggle__icon {
    color: #fff
}

.modalToggle__icon {
    margin: 0 .5rem 0 0;
    font-size: 1.3rem;
    color: #2e49ed
}

.modalToggle__icon--marker {
    font-size: 1.7rem
}

.checkArea {
    position: relative;
    font-size: 1.4rem;
    color: #727272;
    font-feature-settings: "palt"
}

.checkArea__frame {
    width: 100%
}

.checkArea__left {
    position: relative;
    z-index: 2;
    width: 42rem;
    max-height: calc(90vh - 13rem)
}

.checkArea__left--col1 {
    width: 100%
}

.checkArea__right {
    position: relative;
    z-index: 1;
    width: calc(100% - 42rem);
    max-height: calc(90vh - 13rem)
}

.checkArea__base {
    position: relative;
    z-index: 2;
    padding: 0 3rem;
    border-top: 1px solid #d2d7e1;
    border-right: 1px solid #d2d7e1;
    width: 100%;
    height: 6.5rem;
    font-weight: 700;
    transition-duration: .5s
}

.acc-check:checked ~ .checkArea__base {
    background: #e7ebff
}

.checkArea__base--0 {
    border-top: 0
}

.checkArea__check {
    margin: 0 1rem 0 0;
    width: 1.6rem;
    height: 1.6rem
}

.checkArea__text {
    width: calc(100% - 2rem)
}

.checkArea__val {
    display: inline-block;
    margin: 0 0 0 1rem;
    font-size: 1rem;
    font-weight: 400;
    color: #969595
}

.checkArea__label {
    padding: 1rem 2rem;
    width: 100%;
    font-weight: 700
}

.checkArea__label--head {
    border-bottom: 1px solid #e7ebff;
    min-height: 6rem;
    line-height: 1
}

.checkArea__label--col2 {
    width: 50%
}

.spAccount__btn {
    width: 49%;
    height: 5rem;
    font-size: 1.4rem;
    font-weight: 700
}

.spAccount__btn--login {
    border: 1px solid #dedede
}

.spAccount__icon {
    margin: 0 .5rem 0 0;
    font-size: 1.6rem;
    color: #2e49ed
}

select {
    padding: 0 2rem;
    background-image: url(data:image/png;base64,);
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 12px;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none
}

select::-ms-expand {
    display: none
}

.swiper-pagination {
    width: 100%
}

.swiper-pagination .swiper-pagination-bullet {
    margin: 0 1rem;
    border: 1px solid #383838;
    border-radius: 50%;
    width: 1rem;
    height: 1rem;
    outline: 0;
    opacity: 1
}

.swiper-pagination .swiper-pagination-bullet-active {
    background: #383838
}

.slideCtrl {
    margin: 3rem 0 0
}

.slideCtrl__btn {
    border: 1px solid #e4eaf0;
    border-radius: .5rem;
