.spJobSearch {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 3001;
    padding: 0 3.125%;
    width: 100%;
    background: #fff
}

.spJobSearch:after, .spJobSearch:before {
    display: block;
    content: ""
}

.spJobSearch:before {
    padding: 5rem 0 0
}

.spJobSearch:after {
    padding: .5rem 0 0
}

.spJobSearch__pad {
    padding: 1rem 0 0
}

.spJobSearch__list {
    width: 100%
}

.spJobSearch__box {
    position: relative;
    width: calc(100% - 4rem)
}

.spJobSearch__btn {
    position: absolute;
    top: 50%;
    right: .5rem;
    border: 0;
    font-size: 1.6rem;
    color: #1e67ef;
    background: 0;
    transform: translateY(-50%)
}

.spJobSearch__input {
    padding: .5rem 3rem .5rem 1rem;
    border: 1px solid #ccc;
    border-radius: .5rem;
    width: 100%
}

.spJobSearch__acc {
    width: 3.5rem
}

.spJobSearch__open {
    position: relative;
    border: 1px solid #ccc;
    border-radius: .5rem;
    width: 3.5rem;
    height: 3.5rem
}

.spJobSearch__body {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 2;
    width: 100%;
    height: calc(100vh - 5rem);
    overflow: auto;
    background: #f2f5f5
}

.spJobSearch__body:after, .spJobSearch__body:before {
    display: block;
    content: ""
}

.spJobSearch__body:after {
    padding: 10rem 0 0
}

.spJobSearch .md-acc .acc-btn .icon {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    font-size: 1.4rem;
    transition-duration: .5s;
    transform: translate(-50%, -50%)
}

.spJobSearch .md-acc .acc-check:checked ~ .acc-btn .icon {
    transform: translate(-50%, -50%) rotate(180deg)
}

