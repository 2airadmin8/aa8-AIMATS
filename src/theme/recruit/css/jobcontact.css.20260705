}

.colBlock__icon {
    position: absolute;
    top: 50%;
    right: 1.5rem;
    font-size: 1.6rem;
    color: #1e67ef;
    transform: translateY(-50%)
}

.colBlock__empty {
    font-size: 1.4rem
}

.colPost {
    margin: 2rem 0 0
}

.colPost__item {
    position: relative;
    padding: 1.7rem 0;
    width: 48%
}

.colPost__img {
    border-radius: .5rem;
    width: 12.8rem;
    overflow: hidden
}

.colPost__title {
    display: -webkit-box;
    width: calc(100% - 14rem);
    overflow: hidden;
    font-size: 1.2rem;
    color: #383838;
    text-align: justify;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical
}

.colPost__blank {
    padding: 2rem 0;
    width: 100%;
    font-size: 1.6rem;
    text-align: center
}

.colPager {
    padding: 3rem 0 0
}

.colBack {
    margin: 3rem 0 0;
    text-align: center
}

.colBack__link:hover {
    text-decoration: underline
}

.single__title {
    padding: 0 0 1rem;
    border-bottom: 5px solid #1e67ef;
