        right: 1.5rem;
        z-index: 2;
        line-height: 1
    }

    .checkArea .acc-check:checked ~ .acc-btn .checkArea__accIcon--off, .checkArea .acc-check:not(:checked) ~ .acc-btn .checkArea__accIcon--on {
        display: none
    }

    .checkArea__left {
        width: 100%;
        max-height: calc(100% - 17.5rem)
    }

    .checkArea__base {
        position: relative;
        padding: .5rem 3rem;
