    top: 50%;
    right: 3rem;
    z-index: 2;
    transform: translateY(-50%)
}

.colIntro {
    margin: 2rem 0 0;
    font-size: 1.3rem;
    line-height: 2;
    text-align: justify
}

.colList {
    margin: 4rem 0 0
}

.colBlock + .colBlock {
    margin: 5.5rem 0 0
}

.colBlock__more {
