}

.mypageSideNav__item + .mypageSideNav__item {
    margin: 2rem 0 0
}

.mypageSideNav__item.active, .mypageSideNav__item:hover {
    border-left: 4px solid #2e49ed;
    color: #2e49ed
}

.mypageSideNav__item.active .mypageSideNav__icon, .mypageSideNav__item:hover .mypageSideNav__icon {
    color: #2e49ed
}

.mypageSideNav__item--logout {
