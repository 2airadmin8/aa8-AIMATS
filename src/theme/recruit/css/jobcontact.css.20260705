    border-radius: 1rem;
    font-size: 1.4rem;
    line-height: 1;
    background: #f2f5f5
}

#toc_container {
    padding: 1.5rem 2rem;
    border: 1px solid #dcdcdc;
    border-top: 15px solid #ffddec;
    border-radius: 8px
}

#toc_container .toc_title {
    margin: 0;
    padding: .5rem 4rem;
    font-weight: 700;
    line-height: 1;
    background-image: url(../img/logo_s.svg);
    background-repeat: no-repeat;
    background-position: 0;
    background-size: 2.8rem auto
}

#toc_container .toc_list {
    margin: 2rem 0 0;
    font-size: 1.5rem
}

#toc_container li {
    margin: 0;
    padding: 0;
