.topEasy__list {
    margin: 2rem 0 0
}

.topEasy__btn {
    height: 6rem
}

.topEasy__btn--search {
    margin: 0 0 0 2rem;
    box-shadow: 0 0 8px rgba(252, 84, 156, .6)
}

.topEasy__icon {
    margin: 0 1rem 0 0;
    font-size: 1.4rem;
    color: #2e49ed
}

.topEasy__icon--pc {
    font-size: 1.5rem
}

.topEasy__icon--marker {
    font-size: 1.7rem
}

.topEasy__icon--search {
    font-size: 1.7rem;
    color: #fff
}

.topEasy__cross {
    padding: 2rem;
    font-size: 1.4rem;
    color: #aaa
}

.topEasy__res {
    display: -webkit-box;
    width: 100%;
    overflow: hidden;
    font-size: 1rem;
    line-height: 1.3;
    color: #aaa;
    text-align: left;
    font-feature-settings: "palt";
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical
}

.topEasy__res:not(.active) {
    display: none
}

.topSearch {
    padding: 4.5rem 0;
    font-feature-settings: "palt";
    background: #f2f5f5
}

.topSearch__title {
    font-size: 1.6rem
}

.topSearch__box {
    margin: 2rem 0 0;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 2px 9px rgba(0, 0, 0, .1)
}

.topSearch__line {
    min-height: 8rem
}

.topSearch__line + .topSearch__line {
    border-top: 1px solid #d2d7e1
}

.topSearch__head {
    padding: 3rem 4.5rem;
    width: 20rem;
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1.3
}

.topSearch__list {
    width: calc(100% - 20rem)
}

.topSearch__list--style {
    padding: 3rem 0 2rem
}

.topSearch__list--free {
    padding: .5rem 0
}

.topSearch__label {
    line-height: 1
}

.topSearch__label--group + .topSearch__label--group {
    margin: 0 0 0 3rem
}

.topSearch__label--style {
    margin: 0 0 1rem;
    width: 33.333%
}

.topSearch__check {
    width: 1.6rem;
    height: 1.6rem
}

.topSearch__text {
    padding: 0 0 0 .5rem;
    font-size: 1.3rem;
    color: #6c6c6c;
    white-space: nowrap
}

.topSearch__btn {
    width: 9rem;
    height: 4rem;
    font-size: 1.3rem;
    font-weight: 700
}

.topSearch__btn.blueLine {
    border-width: 1px
}

.topSearch__btn--free {
    margin: 0 0 0 1rem;
    height: auto
}

.topSearch__btn--send {
    width: 32rem;
    height: 6rem;
    font-size: 1.8rem;
    font-weight: 400
}

.topSearch__res {
    display: -webkit-box;
    margin: 0 2rem;
    max-width: calc(100% - 20rem);
    overflow: hidden;
    font-size: 1.3rem;
    color: #6c6c6c;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical
}

.topSearch__del {
    padding: 0;
    border: 0;
    font-size: 1.4rem;
    color: #2e49ed;
    text-decoration: underline;
    background: 0
}

.topSearch__del:not(.active) {
    display: none
}

.topSearch__del:hover {
    color: #fe6565
}

.topSearch__freeBlock {
    margin: .5rem 0 0;
    width: 100%
}

.topSearch__view {
    margin: 0 1rem 0 0;
    max-width: calc(100% - 10rem);
    font-size: 1.3rem;
    color: #6c6c6c
}

.topSearch__select {
    border: 1px solid #2e49ed;
    border-radius: 1rem;
    width: 20rem;
    height: 4rem;
    font-size: 1.3rem;
    font-weight: 700;
    color: #2e49ed;
    background-color: #fff
}

.topSearch__send {
    margin: 3.8rem 0 0;
