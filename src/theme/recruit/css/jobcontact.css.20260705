}

.contactProfile__name {
    width: 24rem;
    max-width: 49%
}

.contactProfile__name + .contactProfile__name {
    margin: 0 0 0 1rem
}

.contactAddress {
    padding: 3rem
}

.contactAddress input[type=number]::-webkit-inner-spin-button, .contactAddress input[type=number]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0
}

