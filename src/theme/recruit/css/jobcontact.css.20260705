    width: auto
}

.mw_wp_form_confirm .contactTime__btn, .mw_wp_form_confirm .contactTime__clear, .mw_wp_form_confirm .contactTime__icon {
    display: none
}

.colBase {
    margin: 5.5rem 0 16rem
}

.colTitle {
    position: relative;
    padding: 0 3rem;
    border-radius: 1rem;
    height: 9rem;
