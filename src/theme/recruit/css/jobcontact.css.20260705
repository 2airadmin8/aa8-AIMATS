}

.sidePost__item {
    position: relative;
    padding: 1.7rem .8rem 1.7rem 3.5rem
}

.sidePost__item + .sidePost__item {
    border-top: 1px solid #e0e0e0
}

.sidePost__icon {
    position: absolute;
    top: -.2rem;
    left: 1rem;
    z-index: 2;
    font-size: 3rem;
    line-height: 1;
