    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1;
    color: #fe6565
}

.contactTable__input {
    padding: 1rem 2rem;
    border: 1px solid #d2d7e1;
    border-radius: 12px;
    width: 100%;
    line-height: 1;
    background-color: #fafafa
}

.contactTable__input--textarea {
