    color: #fc549c;
    text-align: center;
    white-space: nowrap;
    transform: translate(-50%, -50%)
}

.topCamp__text {
    margin: 1rem 0 0;
    font-size: 1.3rem;
    font-weight: 500;
    color: #fff;
    text-align: center;
