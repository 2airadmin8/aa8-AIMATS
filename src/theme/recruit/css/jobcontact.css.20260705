}

.mw_wp_form_confirm .contactAddress {
    padding: 3rem
}

.mw_wp_form_confirm .contactAddress__name {
    display: none
}

.mw_wp_form_confirm .contactAddress__list {
    margin: 0;
    white-space: nowrap
}

.mw_wp_form_confirm .contactAddress__list--address, .mw_wp_form_confirm .contactAddress__list--pref {
    display: inline-block
}

.mw_wp_form_confirm .contactAddress__head {
    display: none
}

.mw_wp_form_confirm .contactAddress__address, .mw_wp_form_confirm .contactAddress__pref, .mw_wp_form_confirm .contactAddress__zip {
    position: relative
}

.mw_wp_form_confirm .contactAddress__zip {
    margin: 0;
    width: auto
}

.mw_wp_form_confirm .contactAddress__zip:before {
    content: "〒"
}

.mw_wp_form_confirm .contactAddress__zip:last-child {
