}

.slideCtrl__pager .swiper-pagination-bullet {
    margin: 0 .75rem;
    border: 1px solid #2e49ed;
    border-radius: 50%;
    width: 1.3rem;
    height: 1.3rem;
    background: #fff;
    outline: 0;
    opacity: 1;
    cursor: pointer
}

.slideCtrl__pager .swiper-pagination-bullet-active {
    background: #2e49ed
}

.spLinkList {
    padding: 2rem 1rem;
    background: #f2f5f5
}

.spLinkList__item {
    padding: .5rem 1rem;
    width: 50%;
    font-size: 1.3rem;
    color: #5e5e5e;
