}

.mw_wp_form_confirm .contactAddress__zip:last-child:before {
    display: none
}

.mw_wp_form_confirm .contactAddress__address, .mw_wp_form_confirm .contactAddress__pref {
    display: inline-block;
    width: auto
}

.contactSubmit {
