    .modal__header {
        background: #e7ebff
    }

    .modal__footer, .modal__header {
        border-radius: 0
    }

    .modal:not(.active) {
        opacity: 0;
        visibility: hidden
    }

    .modal__frame {
        width: 100%;
        height: 100%;
        transform: none
    }

    .modal__frame--dialog {
        height: auto;
        transform: translate(-50%, -50%)
    }

    .modal__closeBG {
        position: fixed;
        top: 0;
        left: 0;
        z-index: -1;
        width: 100%;
        height: 100%;
        pointer-events: auto;
        cursor: pointer
    }

    .modal__close {
        cursor: pointer
