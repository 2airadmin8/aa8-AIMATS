    line-height: 1;
    color: #fff;
    text-align: center;
    letter-spacing: .1em;
    background-image: linear-gradient(90.22deg, #1f3be3 20.33%, #334ff7 40.12%, #334ff6 64.12%, #1f3be3 88.18%);
    transform: rotate(-45deg);
