}

.contactTable__textarea {
    position: relative
}

.mw_wp_form_confirm .contactTable {
    margin: 2rem 0 0;
    border-radius: 0;
    box-shadow: none
}

.mw_wp_form_confirm .contactTable:not(:first-child) {
    margin: 0;
    border-top: 1px solid #d2d7e1
}

.mw_wp_form_confirm .contactTable:first-child {
    border-radius: 8px 8px 0 0
}

.mw_wp_form_confirm .contactTable:last-child {
