}

.colBlock__head {
    padding: 2rem;
    border-left: 2rem solid #fc549c;
    border-radius: 1rem;
    height: 7rem;
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1;
    color: #fff;
    background: #1e67ef
}

.colBlock__list {
    padding: 2.7rem 0 0
}

.colBlock__item {
    position: relative;
    margin: .3rem 0 0;
    padding: 1.8rem 3.5rem 1.8rem 1.5rem;
    border-radius: 1rem;
    width: 100%;
    overflow: hidden;
    font-size: 1.5rem;
    line-height: 1;
    color: inherit;
    text-overflow: ellipsis;
    white-space: nowrap;
    background: #f2f5f5
}

.colBlock__item:hover {
