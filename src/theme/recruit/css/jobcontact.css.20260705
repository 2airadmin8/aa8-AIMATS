    line-height: 1;
    color: #fff
}

.couBnr__icon {
    margin: 0 0 0 1rem
}

.favoriteList .itemRemove {
    -webkit-animation-name: itemRemove;
    animation-name: itemRemove;
    -webkit-animation-duration: 1s;
    animation-duration: 1s;
    -webkit-animation-timing-function: linear;
    animation-timing-function: linear;
    -webkit-animation-fill-mode: both;
    animation-fill-mode: both
}

@-webkit-keyframes itemRemove {
    50% {
        opacity: 0;
        visibility: hidden
    }
    to {
        position: absolute;
        right: 0;
        height: 0;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
        visibility: hidden
    }
}

@keyframes itemRemove {
    50% {
        opacity: 0;
        visibility: hidden
    }
    to {
        position: absolute;
        right: 0;
        height: 0;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
        visibility: hidden
    }
}

.contents {
    padding-top: 11rem
}

.contents--lp, .contents--mypage {
    padding-top: 8rem
}

.header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 3002;
    width: 100%;
    white-space: nowrap;
    background: #fff;
    box-shadow: 0 0 10px rgba(0, 0, 0, .1)
}

.header__frame {
    padding: 0 0 0 2rem
}

.header__logo-img {
    display: block;
    max-width: 15rem
}

.header__nav {
    margin-right: 1rem
}

.headerTop {
    font-size: 1rem;
    line-height: 1.4;
    color: #333;
    background: #f9f9f9
}

.headerTop__pad {
    padding: 0 2rem
}

.headerTop__item {
    max-width: 49%;
    height: 3rem;
    white-space: wrap
}

.headerTop__text {
    width: 100%
}

.headerSystem {
    line-height: 1;
    text-align: center
}

.headerSystem__book:not(.active) {
    display: none
}

.headerSystem__chip {
    position: absolute;
    top: 0;
    right: .5rem;
    z-index: 2;
    border-radius: 50%;
    width: 1.8rem;
    height: 1.8rem;
    font-size: 1rem;
    color: #fff;
    background: #fe6565;
    transform: scale(.9);
    transform-origin: center
}

.headerSystem__chip:not(.active) {
    display: none
}

.headerSystem__block {
    position: relative;
    border-left: 1px solid #d2d7e1;
    width: 6.5rem;
    height: 4.5rem;
    cursor: pointer
}

.headerSystem__block.active, .headerSystem__block:hover {
    opacity: .6
}

.headerSystem__icon {
    height: 1.6rem;
    font-size: 1.4rem;
    color: #2e49ed
}

.headerSystem__icon--user {
    font-size: 1.6rem
}

.headerSystem__icon--mail {
    font-size: 1.2rem
}

.headerSystem__icon--home {
    font-size: 1.6rem
}

.headerSystem__name {
    margin: .5rem 0 0;
    font-size: 1rem;
    font-weight: 500;
    color: #383838;
    white-space: nowrap
}

.headerEntry__btn {
    margin: 0 1rem;
    width: 14rem;
    height: 4.5rem;
    font-size: 1.5rem;
    font-weight: 700
}

.headerPulldown {
    position: relative;
    font-size: 1.4rem
}

.headerPulldown__head {
    padding: 1rem 2.5rem;
    height: 8rem;
    font-weight: 500;
    line-height: 1;
    color: inherit;
    transition-duration: .5s;
    cursor: pointer
}

.headerPulldown__bar {
    padding: 1rem .5rem
}

.headerPulldown__body {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 2;
    border-radius: 0 0 3rem 3rem;
    overflow: hidden;
    background: #fff;
    opacity: 0;
    transition-duration: .5s;
    transform: translate(-50%) rotateX(90deg);
    transform-origin: 0 0
}

.headerPulldown__link {
    padding: 2rem 2.8rem;
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1;
    color: #383838
}

.headerPulldown__link:last-child {
    padding-bottom: 3rem
}

.headerPulldown__link.active, .headerPulldown__link:hover {
    background: #e7ebff
}

.headerPulldown__icon {
    margin: 0 0 0 10rem;
    font-size: 1.2rem;
    color: #b4b4b4
}

.headerPulldown:hover .headerPulldown__head:before {
    transform: none
}

.headerPulldown:hover .headerPulldown__body {
    opacity: 1;
    transform: translate(-50%) rotateX(0)
}

.spNav {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 10001;
    width: 100%;
    height: 100%;
    transition-duration: .5s;
    transform-origin: 0 0;
    pointer-events: none
}

.spNav:not(.active) {
    transform: translate(100%);
    visibility: hidden
}

.spNav__close {
    z-index: 2;
    padding: 1.25rem 0 0;
    width: 5rem;
    font-size: 2rem;
    line-height: 1;
    color: #fff;
    text-align: center
}

.spNav__frame {
    width: calc(100% - 5rem);
    max-height: 100%;
    overflow: auto;
    background: #fff;
    pointer-events: auto
}

.spNav__logo {
    padding: 3rem
}

.spNav__logoLink {
    width: 14rem
}

.spNav__account {
    padding: 0 3.125%
}

.spNav__list {
    margin: 1.5rem 0 0
}

.spNav__item {
    padding: 0 2rem;
    border-top: 1px solid #d2d7e1;
    height: 5.5rem;
    font-weight: 500;
    color: #383838;
    background: #fff
}

.spNav__icon {
    width: 4rem;
    color: #2e49ed;
    text-align: center
}

.spNav__icon--heart, .spNav__icon--search {
    font-size: 1.5rem
}

.spNav__icon--logo {
    font-size: 1.7rem
}

.spNav__icon--book {
    font-size: 1.4rem
}

.spMenuBtn {
    display: inline-block;
    position: relative;
    width: 4.5rem;
    height: 4.5rem;
    vertical-align: middle;
    cursor: pointer
}

.spMenuBtn__box {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 100%;
    height: 100%
}

.spMenuBtn__bar {
    display: block;
    position: absolute;
    left: 1rem;
    z-index: 2;
    border-radius: 5px;
    width: calc(100% - 2rem);
    height: 3px;
    background: #383838;
    transition-duration: .5s;
    transform-origin: 50% 50%
}

.spMenuBtn__bar:first-of-type {
    top: 1.25rem
}

.spMenuBtn__bar:nth-of-type(2) {
    top: 50%;
    margin-top: -1.5px
}

.spMenuBtn__bar:nth-of-type(3) {
    bottom: 1.25rem
}

.spMenuBtn.active .spMenuBtn__bar {
    background: #383838
}

.spMenuBtn.active .spMenuBtn__bar:first-of-type {
    top: 50%;
    margin-top: -1.5px;
    transition: top .5s, margin .5s, transform .5s ease .5s;
    transform: rotate(-45deg)
}

.spMenuBtn.active .spMenuBtn__bar:nth-of-type(2) {
    opacity: 0;
    transition-delay: .4s;
    transform: rotateY(90deg)
}

.spMenuBtn.active .spMenuBtn__bar:nth-of-type(3) {
    bottom: 50%;
    margin-bottom: -1.5px;
    transition: bottom .5s, margin .5s, transform .5s ease .5s;
    transform: rotate(45deg)
}

.headerAccount {
    position: relative;
    border-left: 1px solid #eaeded;
    width: 24rem;
    height: 8rem
}

.headerAccount__name {
    font-weight: 700;
    color: #727272
}

.headerAccount__icon {
    margin: 0 0 0 1.5rem;
    font-size: .8rem;
    color: #ccc
}

.headerAccount__btn {
    padding: 1rem
}

.headerAccount__user {
    max-width: 15rem;
    text-align: justify;
    font-feature-settings: "palt";
    white-space: normal
}

.headerAccount__body {
    position: absolute;
    top: calc(100% - 1.5rem);
    left: 0;
    z-index: 2;
    width: 100%
}

.headerAccount__delta {
    position: relative;
    height: 1rem
}

.headerAccount__delta:after, .headerAccount__delta:before {
    display: inline-block;
    position: absolute;
    right: 2rem;
    content: ""
}

.headerAccount__delta:before {
    top: 0;
    z-index: 1;
    border-color: transparent transparent #e4eaf0
}

.headerAccount__delta:after, .headerAccount__delta:before {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0 10px 10px
}

.headerAccount__delta:after {
    top: 1px;
    z-index: 2;
    border-color: transparent transparent #fff
}

.headerAccount__box {
    border: 1px solid #e4eaf0;
    border-radius: 1rem;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 2px 12px rgba(0, 0, 0, .14)
}

.headerAccount__info {
