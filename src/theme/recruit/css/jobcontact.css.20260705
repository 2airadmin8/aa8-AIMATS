    line-height: 1;
    color: #d2d7e1;
    text-align: center;
    transition-duration: .5s
}

.mypageSideNav__icon--gear, .mypageSideNav__icon--home {
    font-size: 1.8rem
}

.mypageSideNav__icon--target {
    font-size: 2.2rem
}

.mypageSideNav__icon--mail {
    font-size: 1.2rem
}

.mypageSideNav__icon--doc {
    font-size: 1.8rem
}

.mypageSideNav__icon--heart {
    font-size: 1.5rem
}

.mypageSideNav__icon--history {
    font-size: 1.8rem
}

.mypageSideNav__icon--logout {
    font-size: 1.7rem;
    color: #878787
}

.mypageSideNav__bar {
    margin: 3rem 0;
    width: 100%;
    height: 1px;
    background: #d2d7e1
}

.side.side--job .side__head {
    padding: 1.5rem 1rem;
    border-bottom: 0;
    height: 5.5rem
}

.side.side--job .side__title {
    font-size: 1.7rem;
    font-weight: 700
}

.side.side--job .side__body {
    padding: 1.5rem 1rem
}

.sideJob {
    font-feature-settings: "palt"
}

.sideJob + .sideJob {
    margin: 4rem 0 0
}

.sideJob__title {
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1
}

.sideJob__btn {
    width: 9rem;
    height: 3.5rem;
    font-size: 1.3rem;
    font-weight: 700
}

.sideJob__list {
    margin: 1rem 0 0
}

.sideJob__select {
    border: 1px solid #2e49ed;
    border-radius: 1rem;
    width: 100%;
    height: 4rem;
    font-size: 1.3rem;
    font-weight: 700;
    color: #2e49ed;
    background-color: #fff
}

.sideJob__style {
    font-size: 1.3rem;
    font-weight: 700;
    color: #6c6c6c
}

.sideJob__styleIcon {
    margin: 0 .5rem
}

.sideJobCheck {
    font-size: 1.3rem
}

.sideJobCheck:not(.active) {
    display: none
}

.sideJobCheck--child {
    padding-left: 1rem;
    font-size: 1.1rem
}

.sideJobCheck__check {
    width: 1.4rem
}

.sideJobCheck__text {
    padding: 0 0 0 .5rem;
    width: calc(100% - 2rem)
}

.sideJobCheck__blank {
    font-size: 1.3rem;
    color: #979fa8
}

.sideJobCheck__blank:not(.active) {
    display: none
}

.sideJobSearch {
    position: relative;
    width: 100%
}

.sideJobSearch__label {
    position: relative;
    width: calc(100% - 6.5rem)
}

.sideJobSearch__icon {
    position: absolute;
    top: 50%;
    right: 1rem;
    z-index: 2;
    font-size: 1.4rem;
    color: #2e49ed;
    transform: translateY(-50%)
}

.sideJobSearch__form {
    padding: .5rem 3rem .5rem .5rem;
    border: 1px solid #d2d7e1;
    border-radius: 1rem;
    width: 100%;
    height: 4rem;
    font-size: 1.4rem;
    background: #e7ebff
}

.sideJobSearch__btn {
    margin: 0 0 0 .5rem;
    width: 6rem;
    height: 4rem;
    font-size: 1.4rem
}

.sideJobSearch__word {
    padding: .5rem 0 0;
    width: 100%;
    font-size: 1.2rem
}

.sideJobSend {
    padding: 2rem;
    border-radius: 0 0 1rem 1rem;
    background: #e7ebff
}

.sideJobSend__btn {
    height: 4.5rem;
    font-size: 1.7rem
}

.sideJobSend__val {
    margin: 0 0 0 .2rem;
    font-size: 1.2rem
}

.svPoint {
    padding: 9rem 0 7rem
}

.svPoint__title {
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1;
    text-align: center
}

.svPoint__item {
    margin: 4rem 0 0;
    width: 32%;
    text-align: center;
    font-feature-settings: "palt";
    white-space: nowrap
}

.svPoint__img {
    padding: 0 20%
}

.svPoint__head {
    padding: 0 1rem;
    font-size: 3.1rem;
    font-weight: 700;
    line-height: 1.3;
    color: #727272;
    letter-spacing: .1em
}

.svPoint__text {
    margin: 2rem 0 0;
    font-size: 1.3rem;
    line-height: 2
}

.svCamp {
    margin: 3rem 0 0;
    padding: 2.5rem 4.5rem;
    border: 1px solid #fc549c;
    border-radius: 1rem;
    background: #fff
}

.svCamp__head {
    padding: .5rem 0;
    width: 15rem;
    font-size: 1.7rem;
    font-weight: 500
}

.svCamp__text {
    width: calc(100% - 15rem);
    font-size: 1.2rem;
    line-height: 2;
    text-align: justify
}

.svFaq__nav {
    margin: 4rem auto 0;
    max-width: 64rem
}

.svFaq__btn {
    margin: 1rem .5rem 0;
    border: 1px solid #868686;
    border-radius: .5rem;
    width: 15rem;
    max-width: 49%;
    height: 5rem;
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1;
    text-align: center;
    background: #d4d4d4;
    cursor: pointer
}

.svFaq__btn.active {
    border-color: #2e49ed;
    color: #2e49ed;
    background: #fff
}

.svFaq__move {
    pointer-events: none
}

.svFaq .swiper-slide:not(.swiper-slide-active) {
    height: 0;
    overflow: hidden;
    opacity: 0
}

.svRec {
    padding: 6.5rem 0 7.5rem
}

.svRec__map {
    margin: 4.5rem 0 0;
    border-radius: 1rem;
    overflow: hidden;
    filter: grayscale(100%);
    transition-duration: .3s
}

.svRec__map:hover {
    filter: none
}

.svRec__map iframe {
    width: 100%;
    height: 38rem
}

.svRec__table {
    margin: 2.5rem 0 0;
    border: 1px solid #d7d7d7;
    border-radius: 1rem
}

.svRec__tr {
    padding: 2.5rem 0
}

.svRec__tr + .svRec__tr {
    border-top: 1px solid #d7d7d7
}

.svRec__th {
    padding: 0 0 0 6.5rem;
    width: 26rem;
    font-size: 1.7rem;
    font-weight: 500
}

.svRec__td {
    width: calc(100% - 26rem);
    font-size: 1.5rem
}

.regBody {
    padding: 9rem 0 10rem
}

.regInfoBar {
    margin: 0 0 2rem
}

.regBlock {
    border: 1px solid #c4c4c4;
    border-radius: 1rem;
    background: #fff
}

.regBlock__body {
    padding: 2rem 0 3rem
}

.regTitle {
    padding: 4.5rem 4rem;
    border-bottom: 1px solid #d2d7e1;
    min-height: 12rem;
    line-height: 1;
    text-align: center
}

.regTitle__in {
    width: 100%
}

.regTitle__text {
    font-size: 2.5rem;
    font-weight: 500
}

.regTitle__connect {
    margin: 2rem 0 0;
    padding: 1rem;
    border: 2px solid #afbbf9;
    border-radius: .5rem;
    min-height: 6rem;
    font-size: 1.3rem;
    color: #969595;
    background: #f1f3ff
}

.regHead {
    border-radius: 3rem;
    height: 2rem;
    font-size: 1.1rem;
    text-align: center;
    background: #f1f3ff
}

.regSns {
    margin: 3rem auto 4rem;
    max-width: 100%
}

.regSns__item {
    position: relative;
    margin: 0 auto;
    border-radius: 1rem;
    max-width: 50rem;
    height: 5rem;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: .1em
}

.regSns__item + .regSns__item {
    margin: 1rem auto 0
}

.regSns__item:hover {
    opacity: .8
}

.regSns__item--half {
    margin: 1rem 0 0;
    width: 48%
}

.regSns__item--google {
    border: 1px solid #b2b2b2;
    color: #2d2d2d
}

.regSns__item--line {
    color: #fff;
    background: #00b900
}

.regSns__item--yahoo {
    border: 1px solid #fe0034;
    color: #fe0034
}

.regSns__item--facebook {
    color: #fff;
    background: #1778f2
}

.regSns__icon {
    position: absolute;
    top: 50%;
    left: 1.5rem;
    z-index: 2;
    width: 3rem;
    line-height: 1;
    text-align: center;
    transform: translateY(-50%)
}

.regSns__icon--line {
    font-size: 2.4rem
}

.regSns__icon--yahoo {
    font-size: 1.7rem
}

.regSns__icon--facebook {
    font-size: 2.2rem
}

.regSns__note {
    margin: 1rem 0 0;
    font-feature-settings: "palt";
    font-size: 1rem;
    text-align: center
}

.regSns__note--lp {
    width: 100%;
    font-size: 1.4rem;
    text-align: center
}

.regForm {
    margin: 3rem 0 0;
    font-feature-settings: "palt"
}

.regForm__tr:not(:first-child) {
    margin: 1rem 0 0
}

.regForm__error {
    margin: .3rem 0 0;
    font-size: 1rem;
    color: #fe6565
}

.regForm__th {
    width: 10rem;
    font-size: 1.4rem;
    line-height: 1;
    text-align: right
}

.regForm__td {
    position: relative;
    width: calc(100% - 13rem)
}

.regForm__td--login {
    width: calc(100% - 10rem)
}

.regForm__half {
    width: 49%
}

.regForm__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none
}

.regForm__input, .regForm__label {
    display: block;
    padding: 1.5rem;
    border: 1px solid #d2d7e1;
    border-radius: 1rem;
    width: 100%;
    font-size: 1.3rem;
    line-height: 1;
    background: #fafafa
}

.regForm__label {
    font-size: 1.2rem;
    color: #717171;
    text-align: center;
    background: #fff
}

:checked + .regForm__label {
    background: #eff2ff
}

.regForm__magazine {
    padding: 1.5rem 0;
    font-size: 1.2rem;
    line-height: 1
}

.regBtn, .regForm__btn {
    height: 7rem
}

.regBtn {
    margin: 3.5rem 0 0;
    font-weight: 500;
    line-height: 1
}

.regBtn--lp {
    margin: 1.5rem 0 0;
    font-size: 3rem
}

.regBtn__icon {
    font-size: .8em
}

.regBtn__sub {
    font-size: 1.4rem
}

.regBtn__main {
    margin: 1rem 0 0;
    font-size: 1.9rem
}

.regInfo {
    margin: 3rem 0 0;
    font-size: 1.3rem;
    line-height: 1
}

.regInfo__item {
    margin: 0 1.5rem;
    text-decoration: underline
}

.regInfo__item:hover {
    text-decoration: none
}

.regDone {
    border-radius: 1rem;
    width: 50rem;
    max-width: 100%;
    height: 50rem;
    text-align: center;
    background: #fff;
    transition-duration: .5s
}

.regDone__in {
    width: 100%
}

.regDone__text {
    margin: 5rem 0 0;
    font-size: 2rem;
    font-weight: 700;
    line-height: 2
}

.regDone__text--leave {
    margin: 5rem 0
}

.regDone__more {
    margin: 2rem 0 0;
    text-align: center
}

.regDone__btn {
    width: 20rem;
    max-width: 100%;
    height: 6rem;
    font-size: 1.6rem;
    font-weight: 500
}

.privacy {
    text-align: justify;
    font-feature-settings: "palt"
}

.privacySec + .privacySec {
    margin: 8.5rem 0 0
}

.privacyTitle {
    margin: 0 0 3.5rem;
    padding: 0 3rem;
    border-radius: 1rem;
    height: 6.6rem;
    font-size: 1.9rem;
    background: #e7ebff
}

.privacyHead, .privacyTitle {
    font-weight: 700;
    line-height: 1
}

.privacyHead {
    margin: 0 0 1rem;
    padding: 0 0 1.5rem;
    border-bottom: 1px solid #c4c4c4;
    font-size: 2rem
}

.privacyHead__no {
    color: #2e49ed
}

.privacyHead__no:after {
    color: #383838;
    content: "."
}

.privacyText {
    margin: 0 0 4.2rem;
    font-size: 1.6rem
}

.privacyText--intro {
    margin: 0 0 2.5rem
}

.privacyText__head {
    font-size: 1.7rem
}

.privacyText__list {
    padding: 0 0 0 1.5em;
    font-size: 1.5rem
}

.privacyNote {
    padding: 1rem 0 17rem
}

.privacyNote__title {
    font-size: 1.9rem;
    line-height: 1
}

.privacyNote__box {
    margin: 2rem 0 0;
    padding: 3rem 2rem;
    border-radius: 1rem;
    background: #f2f5f5
}

.privacyNote__head {
    font-size: 1.7rem;
    line-height: 1
}

.privacyNote__head:not(:first-child) {
    margin: 2rem 0 0
}

.privacyNote__text {
    margin: .5rem 0 0;
    font-size: 1.4rem
}

.mypageFrame {
    min-height: calc(100vh - 16.5rem)
}

.mypageFrame__sub {
    width: 25rem
}

.mypageFrame__main {
    padding: 4rem 4rem 12rem;
    width: calc(100% - 25rem)
}

.mypageBread {
    padding: .5rem 2rem;
    min-height: 7rem;
    background: #fff
}

.mypageBread__item {
    font-size: 1.6rem;
    font-weight: 700
}

.mypageBread__item--link {
    color: #bdbdbd;
    text-decoration: underline
}

.mypageBread__item--link:hover {
    text-decoration: none
}

.mypageBread__sep {
    margin: 0 1rem;
    color: #bdbdbd
}

.mypageHead {
    position: relative;
    padding: 0 0 1.5rem;
    border-bottom: 1px solid #b2b2b2;
    font-size: 1.8rem;
    font-weight: 700
}

.mypageHead:before {
    display: block;
    position: absolute;
    bottom: -1px;
    left: 0;
    z-index: 2;
    border-radius: .5rem .5rem 0 0;
    width: 24rem;
    height: 3px;
    background: #2e49ed;
    content: ""
}

.mypageBox {
    margin: 3rem 0 0
}

.mypageInfo__item {
    margin: 0 0 2rem;
    border: 1px solid #eaeded;
    border-radius: 8px;
    width: 36rem;
    max-width: 22%;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, .1)
}

.mypageInfo__item--wide {
    width: 83.5rem;
    max-width: 50%
}

.mypageInfo__head {
    padding: .5rem 2.5rem;
    width: 100%;
    height: 7rem;
    font-size: 1.8rem;
    font-weight: 500;
    background: #fafafa
}

.mypageInfo__bottom {
    margin: 1rem 0 0;
    text-align: right
}

.mypageInfo__btn {
    padding: 1rem 1.5rem;
    width: auto;
    font-size: 1.6rem
}

.mypageMessage {
    display: block;
    padding: 2rem;
    color: #535353
}

.mypageMessage:hover {
    background: #fafafa
}

.mypageMessage + .mypageMessage {
    border-top: 1px solid #eaeded
}

.mypageMessage__head {
    font-size: 1.6rem;
    font-weight: 700
}

.mypageMessage__text {
    margin: 1rem 0 0;
    font-size: 1.4rem;
    font-weight: 500;
    text-align: justify
}

.mypageInfoProfile {
    width: 100%
}

.mypageInfoProfile__pad {
    padding: 2rem
}

.mypageInfoProfile__head {
    width: 100%;
    line-height: 1
}

.mypageInfoProfile__per {
    font-size: 1.6rem;
    font-weight: 700
}

.mypageInfoProfile__date {
    font-size: 1.4rem;
    font-weight: 500
}

.mypageInfoProfile__graph {
    margin: 1.5rem 0 0
}

.mypageInfoProfile__text {
    padding: 2rem;
    border-top: 1px solid #eaeded
}

.mypageInfoProfile__main {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1
}

.mypageInfoProfile__sub {
    margin: 1rem 0 0;
    font-size: 1.4rem;
    font-weight: 500
}

.mypageInfoProfile__bottom {
    margin: 1rem 0 0;
    text-align: right
}

.mypageStatus {
    width: 100%
}

.mypageStatus__list {
    width: 100%;
    height: calc(100% - 7rem)
}

.mypageStatus__item {
    width: 50%
}

.mypageStatus__item + .mypageStatus__item {
    border-left: 1px solid #eaeded
}

.mypageStatus__block {
    display: block;
    padding: 2rem;
    color: inherit
}

.mypageStatus__block + .mypageStatus__block {
    border-top: 1px solid #eaeded
}

.mypageStatus__block--link:hover {
    background: #eaeded
}

.mypageStatus__line + .mypageStatus__line {
    margin: 1.5rem 0 0
}

.mypageStatus__head {
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1
}

.mypageStatus__head--now {
    font-size: 1.6rem;
    font-weight: 700
}

.mypageStatus__data {
    font-size: 1.6rem;
    font-feature-settings: "palt";
    font-weight: 700;
    line-height: 1;
    text-align: right
}

.mypageStatus__val {
    font-size: 2.4rem;
    font-weight: 500
}

.mypageStatus__icon {
    width: 3rem;
    font-size: 1.4rem;
    line-height: 1;
    color: #2e49ed
}

.mypageStatus__icon--heart {
    font-size: 1.4rem
}

.mypageStatus__bottom, .mypageStatus__top {
    padding: 2rem
}

.mypageStatus__title {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1
}

.mypageStatus__history {
    margin: 1rem 0 0
}

.mypageStatus__post {
    display: block;
    width: 100%;
    overflow: hidden;
    font-size: 1.4rem;
    font-weight: 500;
    color: #2e49ed;
    text-decoration: underline;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-feature-settings: "palt"
}

.mypageStatus__post:hover {
    text-decoration: none
}

.mypageStatus__post + .mypageStatus__post {
    margin: 1rem 0 0
}

.mypageStatus__postIcon {
    margin: 0 .5rem 0 0
}

.mypagePosts {
    margin: 4rem 0 0
}

.mypagePosts__slide {
    position: relative;
    padding: 2rem 3rem 0
}

.mypagePosts__btn {
    position: absolute;
    top: 50%;
    z-index: 2;
    font-size: 3rem;
    line-height: 1;
    color: #2e49ed;
    transform: translateY(-50%);
    cursor: pointer
}

.mypagePosts__btn--prev {
    left: 0
}

.mypagePosts__btn--next {
    right: 0
}

.mypageInfoGraph {
    position: relative;
    border: 1px solid #ceba92;
    border-radius: 1rem;
    width: 100%;
    height: 7rem;
    overflow: hidden;
    background: #ffeddc
}

.mypageInfoGraph__bar {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    height: 100%;
    background: #ff9d14;
    -webkit-animation-duration: 1s;
    animation-duration: 1s
}

.mypageInfoGraph__val {
    position: absolute;
    top: 50%;
    left: 1em;
    z-index: 3;
    font-size: 4rem;
    color: #fff;
    transform: translateY(-50%)
}

.mypageInfoGraph__unit {
    margin: 0 0 0 .1em;
    font-size: .7em
}

.myproTable {
    margin: 4rem 0 0;
    border: 1px solid #d7d7d7;
    border-radius: 8px;
    overflow: hidden;
    font-feature-settings: "palt";
    background: #fff
}

.myproTable + .myproTable {
    margin: 2rem 0 0
}

.myproTable__head {
    position: relative;
    width: 20rem;
    font-size: 1.8rem;
    font-weight: 500;
    line-height: 1.2
}

.myproTable__in {
    padding: 0 1rem 0 0
}

.myproTable__chip {
    display: inline-block;
    margin: .5rem 0 0;
    padding: .5rem 1rem;
    border: 1px solid #fe6565;
    border-radius: .5rem;
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1;
    color: #fe6565
}

.myproTable__chip--side {
    margin: 0 0 0 .5rem
}

.myproTable__chip--free {
    border-color: #2e49ed;
    color: #2e49ed
}

.myproTable__body {
    border-left: 1px solid #d2d7e1;
    width: calc(100% - 20rem)
}

.myproTable__bar {
    border-bottom: 1px solid #d2d7e1;
    width: 100%;
    height: 1px
}

.myproTable__tr {
    width: 100%
}

.myproTable__tr:last-child .myproTable__td {
    border-bottom: 0
}

.myproTable__th {
    padding: 0 0 0 3rem;
    border-right: 1px solid #d2d7e1;
    width: 13rem;
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1
}

.myproTable__th--pass {
    width: 24rem
}

.myproTable__th--school {
    width: 18rem
}

.myproTable__td {
    padding: 1.5rem;
    border-bottom: 1px solid #d2d7e1;
    width: calc(100% - 13rem);
    min-height: 8rem
}

.myproTable__td--pass {
    width: calc(100% - 24rem)
}

.myproTable__td--school {
    width: calc(100% - 18rem)
}

.myproTable__td--free {
    padding: 0
}

.myproTable__td--data, .myproTable__td--full {
    width: 100%
}

.myproTable__line {
    padding: 1.5rem;
    width: 100%
}

.myproTable__line + .myproTable__line {
    border-top: 1px solid #d2d7e1
}

.myproTable__form {
    width: 100%;
    max-width: 100%
}

.myproTable__form--name {
    width: 24rem;
    max-width: 49%
}

.myproTable__form--name + .myproTable__form--name {
    margin: 0 0 0 1rem
}

.myproTable__form--year {
    width: 18rem;
    max-width: 40%
}

.myproTable__form--date {
    margin: 0 0 0 2rem;
    width: 10rem;
    max-width: 29%
}

.myproTable__form--count {
    width: 12rem
}

.myproTable__form--gen {
    width: 10rem;
    font-size: 1.3rem;
    line-height: 1
}

.myproTable__form--pass {
    width: 28rem;
    font-size: 1.6rem
}

.myproTable__form--lastAct {
    width: 30rem
}

.myproTable__form--schoolName {
    width: 38rem;
    font-size: 1.6rem
}

.myproTable__form--carrier {
    width: 18rem
}

.myproTable__form--work {
    width: 13rem;
    font-size: 1.3rem
}

.myproTable__form--url {
    width: 64rem
}

.myproTable__input {
    padding: 1rem 2rem;
    border: 1px solid #d2d7e1;
    border-radius: 12px;
    width: 100%;
    font-size: 1.3rem;
    line-height: 1;
    background-color: #fafafa
}

.myproTable__input--textarea {
    height: 13rem;
    line-height: 1.5
}

.myproTable__unit {
    margin: 0 0 0 1rem;
    font-size: 1.3rem;
    font-weight: 500;
    white-space: nowrap
}

.myproTable__unit--left {
    margin: 0 1rem 0 0
}

.myproTable__radio {
    margin: 0 1rem 0 0;
    width: 1.6rem;
    height: 1.6rem
}

.myproTable__res {
    margin: 0 2rem;
    font-size: 1.3rem;
    color: #6c6c6c
}

.myproData {
    width: 30rem
}

.myproCarrier {
    position: relative;
    width: 100%;
    max-width: 60rem
}

.myproCarrier--head {
    max-width: 100%
}

.myproCarrier:not(.active) {
    display: none
}

.myproCarrier + .myproCarrier {
    margin: 1rem 0 0
}

.myproCarrier__name {
    font-size: 1.3rem
}

.myproCarrier__clear {
    margin: 0 0 0 1rem;
    cursor: pointer
}

.myproCarrier__clear:hover {
    color: #fe6565
}

.myproCarrier__blank {
    position: absolute;
    top: 1rem;
    left: 9rem;
    z-index: 2
}

.myproCarrier__blank:not(.active) {
    opacity: 0
}

.myproSkill {
    padding: 1.5rem 2rem;
    width: 100%;
    font-size: 1.4rem
}

.myproSkill--profile {
    padding: 1.5rem
}

.myproSkill + .myproSkill {
    border-top: 1px solid #d2d7e1
}

.myproSkill__head {
    width: 10rem
}

.myproSkill__name {
    font-size: 1.4rem
}

.myproSkill--profile {
    width: 100%
}

.myproSkill__note {
    margin: 1rem 0 0;
    width: 100%;
    font-size: 1.2rem;
    line-height: 1.2;
    color: #555
}

.myproSkill__del {
    margin: 0 0 0 1em
}

.customFile {
    position: relative;
    margin: 0 2rem 0 0;
    padding: 1rem;
    border: 2px dashed #d1d8ff;
    border-radius: 1rem;
    overflow: hidden;
    cursor: pointer
}

.customFile__input {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 1;
    width: 100%;
    height: 200%;
    opacity: 0;
    cursor: pointer
}

.customFile__btn {
    margin: 0 0 0 3.5rem;
    padding: .5rem;
    width: 16rem;
    height: 4rem;
    background: #f2f5f5;
    transition-duration: .5s
}

.customFile__text {
    margin-left: 2rem;
    width: 20rem;
    font-size: 1.3rem;
    font-weight: 700;
    color: #c4c4c4;
    text-align: center
}

.myproPort {
    padding: .5rem 2rem 1rem;
    width: 100%;
    max-width: 80rem
}

.myproPort__add {
    margin: 0 0 0 1rem
}

.myproPort__btn {
    width: 12rem;
    height: 4rem;
    font-size: 1.3rem;
    font-weight: 700
}

.myproSend {
    margin: 5rem 0 0
}

.myproSend__btn {
    width: 44rem;
    height: 7rem;
    font-size: 1.9rem;
    font-weight: 500
}

.myproError {
    margin: .3rem 0;
    width: 100%;
    font-size: 1rem;
    color: #fe6565
}

.myproError--zip {
    padding: 0 0 0 15rem
}

.myproError--port {
    padding: 0 2rem
}

.myproEdit {
    margin: 2rem 0;
    line-height: 1
}

.myproEdit--end {
    margin: 4.5rem 0 6.5rem
}

.myproEdit__btn {
    width: 21rem;
    height: 5rem
}

.myproEdit__icon {
    margin: 0 1rem 0 0;
    font-size: 2.2rem;
    color: #2e49ed
}

.myproEdit__text {
    font-size: 1.6rem;
    font-weight: 500;
    color: #727272
}

.myproLeave {
    font-size: 1.5rem;
    line-height: 1
}

.myproLeave__link {
    text-decoration: underline
}

.myproLeave__link:hover {
    text-decoration: none
}

.leaveInfo {
    margin: 2rem 0 0
}

.leaveSec {
    margin: 5.5rem 0 0
}

.leaveSec__head {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1
}

.leaveSec__chip {
    margin: 0 0 0 1rem;
    padding: .3rem .5rem;
    border: 1px solid #fe6565;
    border-radius: .5rem;
    font-size: 1.2rem;
    font-weight: 400;
    line-height: 1;
    color: #fe6565
}

.leaveSec__body {
    margin: 2.5rem 0 0
}

.leaveSec__label {
    font-size: 1.4rem
}

.leaveSec__label + .leaveSec__label {
    margin: 1rem 0 0
}

.leaveSec__check {
    margin: 0 1rem 0 0
}

.leaveSec__textarea {
    padding: 1.5rem 2.5rem;
    border: 1px solid #d5d5d5;
    border-radius: 1rem;
    width: 100%;
    height: 18rem;
    font-size: 1.6rem;
    background: #fff
}

.leaveSend {
    margin: 5rem 0 0
}

.leaveSend__btn {
    border: 1px solid #727272;
    width: 15.5rem;
    height: 4rem;
    font-size: 1.4rem;
    line-height: 1;
    color: #727272;
    background: #fff
}

.lp {
    color: #3a3a3a
}

.lpBlue {
    color: #1e67ef
}

.lpHeader {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10000;
    width: 100%;
    background: #fff
}

.lpHeader__frame {
    height: 8rem
}

.lpHeaderLogo__text {
    margin: 0 0 0 2rem;
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.5
}

.lpHeaderContact {
    line-height: 1;
    white-space: nowrap
}

.lpHeaderContact__tel {
    font-size: 3.4rem;
    font-weight: 700;
    color: #1e67ef
}

.lpHeaderContact__icon {
    font-size: .7em
}

.lpHeaderContact__time {
    margin: .5rem 0 0;
    font-size: 1.6rem;
    font-weight: 500;
    color: #717171;
    font-feature-settings: "palt"
}

.lpHeaderContact__btn {
    margin: 0 0 0 1rem;
    width: 22rem;
    height: 5rem;
    font-size: 2.1rem;
    font-weight: 700
}

.lpHeaderContact__more {
    font-size: .8em
}

.lpMv {
    background-image: url(../img/lp_mv_bg.jpg);
    background-size: cover
}

.lpMv__img {
    padding: 2rem 0 0
}

.lpMvSignUp {
    border-radius: 1rem;
    width: calc(100% - 70rem);
    max-width: 52rem;
    overflow: hidden;
    background: #fff
}

.lpMvSignUp__title {
    height: 5rem;
    font-size: 2.4rem;
    font-weight: 700;
    color: #fff;
    background: #0e49b7
}

.lpContact {
    padding: 1rem 0 0;
    background-image: linear-gradient(90deg, #eff5fe, #fff)
}

.lpContact__chip {
    position: relative;
    padding: .5rem 1rem;
    border-radius: .5rem;
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1;
    color: #fff;
    background: #1e67ef
}

.lpContact__chip:before {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 2;
    transform: translate(-50%);
    content: "";
    width: 0;
    height: 0;
    border-color: #1e67ef transparent transparent;
    border-style: solid;
    border-width: 8px 8px 0
}

.lpContact__chip + .lpContact__chip {
    margin: 0 0 0 1rem
}

.lpContact__title {
    margin: 2rem 0 0;
    padding: 0 0 .5rem;
    font-size: 4.2rem;
    font-weight: 900;
    line-height: 1
}

.lpContact__note {
    margin: 1.5rem 0 0;
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1
}

.lpContact__data {
    margin: 0 0 0 7rem
}

.lpContact__btn {
    max-width: 30rem;
    height: 6rem;
    font-size: 2.4rem;
    font-weight: 700
}

.lpContact__icon {
    font-size: .8em
}

.lpContact__time {
    margin: 2rem 0 0
}

.lpContact__timeHead {
    padding: .5rem 1rem;
    border: 1px solid #cfd6e3;
    border-radius: 1rem;
    font-size: 2.4rem;
    font-weight: 900;
    line-height: 1.2;
    color: #1e67ef
}

.lpContact__timeText {
    margin: 0 0 0 2rem;
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.2
}

.lpContact__timeNote {
    font-size: 1.6rem
}

.lpContact__img {
    margin: 0 0 0 4rem
}

.lpHead {
    font-weight: 900;
    line-height: 1;
    text-align: center
}

.lpHead__sub {
    font-size: 2.6rem
}

.lpHead__ruby {
    font-size: 1rem;
    color: #df338d;
    transform: scale(.8)
}

.lpHead__main {
    margin: 1rem 0 0;
    font-size: 3.6rem
}

.lpHead__no {
    font-size: 5.6rem;
    color: #1e67ef
}

.lpHead__str {
    font-size: 4.8rem;
    color: #1e67ef
}

.lpHead__note {
    margin: 2rem 0 0;
    font-size: 1.6rem;
    font-weight: 500
}

.lpHead__icon {
    margin: 2rem 0 0;
    text-align: center
}

.lpPo {
    padding: 5rem 0 6rem;
    background: #d0def2
}

.lpPo__item {
    margin: 2.5rem 0 0;
    border-radius: 1rem;
    max-width: 33%;
    overflow: hidden;
    background: #fff
}

.lpPo__img {
    position: relative;
    z-index: 1
}

.lpPo__no {
    font-size: 6rem;
    font-weight: 900;
    line-height: 1;
    color: #1e67ef;
    text-align: center
}

.lpPo__unit {
    font-size: 2.1rem;
    font-weight: 300
}

.lpPo__data {
    padding: 2.5rem 0 3rem
}

.lpPo__title {
    margin: 0 0 0 2rem;
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.4
}

.lpPo__text {
    margin: 2rem 0 0;
    font-size: 1.6rem;
    font-weight: 700;
    text-align: center
}

.lpSup {
    padding: 5rem 0;
    background: #edf0f6
}

.lpSup__item {
    margin: 2rem 0 0;
    width: 32%
}

.lpSup__voice {
    position: relative;
    padding: 1.5rem .5rem;
    border: 1px solid #b2c0d9;
    border-radius: 1rem;
    background: #fff
}

.lpSup__voice:after, .lpSup__voice:before {
    position: absolute;
    left: 50%;
    transform: translate(-50%);
    content: ""
}

.lpSup__voice:before {
    top: 100%;
    z-index: 1;
    border-color: #b2c0d9 transparent transparent
}

.lpSup__voice:after, .lpSup__voice:before {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 20px 30px 0
}

.lpSup__voice:after {
    top: calc(100% - 1px);
    z-index: 2;
    border-color: #fff transparent transparent
}

.lpSup__img {
    border-radius: 50%;
    overflow: hidden
}

.lpSup__data {
    margin: 0 0 0 2rem
}

.lpSup__no {
    z-index: 2;
    padding: .5rem;
    border-radius: .5rem;
    line-height: 1;
    color: #1e67ef;
    text-align: center;
    background: #edf0f6
}

.lpSup__no, .lpSup__title {
    font-size: 2rem;
    font-weight: 700
}

.lpSup__title {
    margin: 1rem 0 0
}

.lpSupAns {
    margin: 3.5rem 0 0;
    padding: 0 1.5rem 1.5rem;
    border-radius: 1rem;
    background-image: linear-gradient(125deg, #0d44a7, #3699f5)
}

.lpSupAns__title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #fff;
    text-align: center
}

.lpSupAns__no {
    font-size: 2.8rem
}

.lpSupAns__box {
    padding: 2.5rem 2rem;
    border-radius: 1rem;
    background: #fff
}

.lpSupAns__head {
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: center
}

.lpSupAns__text {
    margin: 2rem 0 0;
    font-size: 1.6rem;
    line-height: 1.5;
    text-align: justify
}

.lpLogoTitle {
    font-weight: 900;
    line-height: 1
}

.lpLogoTitle__text {
    font-size: 3rem
}

.lpLogoTitle__str {
    font-size: 4.2rem;
    color: #1e67ef
}

.lpLogoTitle__slash {
    margin: 1rem 2.5rem 0;
    font-size: 4rem;
    color: #df338d
}

.lpLogo {
    padding: 5rem 0
}

.lpLogo__list {
    margin: 4rem 0 0
}

.lpLogo__sep {
    width: 100%
}

.lpEnt {
    padding: 3rem 0 0;
    background-image: url(../img/lp_contact_bg.jpg);
    background-position: 50%;
    background-size: cover
}

.lpEnt__data {
    margin: 0 0 0 7rem
}

.lpEnt__sub {
    font-size: 2rem;
    font-weight: 700;
    color: #0c3787;
    text-align: center
}

.lpEnt__text {
    padding: .2rem;
    background: #ffcc37
}

.lpEnt__head {
    margin: 1rem 0 0;
    font-weight: 900;
    color: #fff
}

.lpEnt__headText {
    margin: 0 2rem;
    font-size: 4.2rem
}

.lpEnt__slash {
    font-size: 7rem
}

.lpEnt__ruby {
    font-size: 1rem
}

.lpEnt__btn {
    margin: 1rem 0 0;
    max-width: 52.5rem;
    height: 9rem;
    font-size: 3.8rem;
    font-weight: 700
}

.lpEnt__icon {
    font-size: .8em
}

.lpPro {
    padding: 4.5rem 0 6rem;
    background: #d0def2
}

.lpPro__slide {
    position: relative;
    margin: 2rem 0 0;
    padding: 0 7rem
}

.lpPro__item {
    padding: 1rem 2rem 2rem;
    border-top: 1rem solid #0e49b7;
    border-radius: .5rem;
    background: #fff
}

.lpPro__title {
    font-size: 1.6rem;
    font-weight: 700;
    text-align: justify;
    font-feature-settings: "palt"
}

.lpPro__sec {
    margin: 1.5rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid #d0dcf2
}

.lpPro__head {
    padding: .4rem;
    border: 1px solid #d0dcf2;
    border-radius: .5rem;
    width: 8rem;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
    text-align: center
}

.lpPro__text {
    width: calc(100% - 10rem);
    font-weight: 700
}

.lpPro__text--val {
    font-size: 3rem;
    font-feature-settings: "palt";
    font-weight: 900;
    line-height: 1.2;
    white-space: nowrap
}

.lpPro__unit {
    font-size: 1.8rem
}

.lpPro__tag {
    padding: .5rem 1rem;
    border-radius: .5rem;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
    background: #d0dcf2
}

.lpPro__tag + .lpPro__tag {
    margin: 0 0 0 1rem
}

.lpPro .swiper-button {
    position: absolute;
    top: 50%;
    border-radius: 50%;
    width: 6rem;
    height: 6rem;
    font-size: 2.4rem;
    line-height: 1;
    color: #fff;
    background: #1e67ef;
    outline: 0;
    transition-duration: .5s;
    transform: translateY(-50%);
    cursor: pointer
}

.lpPro .swiper-button i {
    line-height: 1
}

.lpPro .swiper-button:after {
    display: none
}

.lpPro .swiper-button-prev {
    left: 0
}

.lpPro .swiper-button-next {
    right: 0
}

.lpVoice {
    padding: 5rem 0;
    overflow: hidden;
    background: #edf0f6
}

.lpVoice .swiper-slide {
    box-sizing: border-box
}

.lpVoice__item {
    padding: 2.5rem;
    border-radius: 1rem;
    width: 100%;
    background: #fff
}

.lpVoice__title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.5
}

.lpVoice__profile {
    margin: .5rem 0 0;
    font-size: 1.4rem;
    font-weight: 500;
    color: #6b6b6b
}

.lpVoice__text {
    margin: 1rem 0 0;
    padding: 1rem;
    border: 1px solid #d0dcf2;
    border-radius: 1rem;
    font-size: 1.4rem;
    font-weight: 500;
    text-align: justify;
    background: #edf0f6
}

.lpVoiceVal {
    margin: .5rem 0 0;
    line-height: 1
}

.lpVoiceVal__before {
    padding: .5rem 0;
    font-size: 1.6rem;
    color: #9d9d9d
}

.lpVoiceVal__after {
    margin: 0 2rem;
    font-size: 2.4rem;
    font-weight: 900
}

.lpVoiceVal__val {
    font-size: 3rem
}

.lpVoiceVal__up {
    padding: .5rem 1rem;
    border-radius: .5rem;
    font-size: 1.6rem;
    font-weight: 700;
    color: #fff;
    background: #df338d
}

.lpCamp {
    padding: 7rem 0 4rem;
    overflow: hidden;
    text-align: center;
    background-image: url(../img/lp_camp_bg.png);
    background-position: 50%;
    background-size: cover
}

.lpCamp__item {
    padding: 1rem;
    width: 49%;
    background: #fff
}

.lpCamp__item, .lpCamp__title {
    border: 1px solid #d0dcf2;
    border-radius: 1rem
}

.lpCamp__title {
    height: 5rem;
    font-size: 2.4rem;
    font-weight: 900;
    line-height: 1;
    text-align: center
}

.lpCamp__title--black {
    color: #fff;
    background: #3a3a3a
}

.lpCamp__act {
    margin: 2rem 0 0
}

.lpCamp__act, .lpCamp__return {
    font-size: 1.8rem;
    font-weight: 900
}

.lpCamp__return {
    padding: 1rem 0;
    line-height: 1
}

.lpCamp__val {
    margin: 0 .5rem 0 0;
    font-size: 4.8rem
}

.lpCamp__pre {
    margin: 0 0 0 .5rem;
    font-size: 2.4rem
}

.lpCamp__note {
    margin: 2.5rem 0 0;
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.5;
    text-align: center
}

.lpStep {
    padding: 6rem 0 5rem;
    text-align: center;
    background: #d0dcf2
}

.lpStep__item {
    position: relative;
    margin: 4rem 0 0;
    padding: 2rem 1rem;
    border-radius: 1rem;
    width: 17%;
    background: #fff;
    filter: drop-shadow(1rem 1rem 1rem rgba(0, 0, 0, .05))
}

.lpStep__item:not(:last-child):before {
    top: 50%;
    left: 100%;
    content: "";
    width: 0;
    height: 0;
    border-color: transparent transparent transparent #fff;
    border-style: solid;
    border-width: 30px 0 30px 20px
}

.lpStep__item:not(:last-child):before, .lpStep__no {
    position: absolute;
    z-index: 2;
    transform: translateY(-50%)
}

.lpStep__no {
    top: 0;
    left: 2rem;
    -webkit-text-stroke: 1px #fff;
    font-size: 4rem;
    font-weight: 900;
    line-height: 1
}

.lpStep__title {
    margin: 2rem 0 0;
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1;
    color: #1e67ef
}

.lpStep__text {
    margin: 1.5rem 0 0;
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.5
}

.lpFaq {
    padding: 5rem 0 7rem
}

.lpFaq__sec {
    margin: 2.5rem 0 0;
    border: 1px solid #d0dcf2;
    border-radius: 1rem
}

.lpFaq__sec + .lpFaq__sec {
    margin: 2rem 0 0
}

.lpFaq__head {
    position: relative;
    padding: 1.5rem 8rem 1.5rem 2rem
}

.lpFaq__icon {
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1
}

.lpFaq__icon--q {
    color: #fff;
    background: #1e67ef
}

.lpFaq__icon--a {
    color: #1e67ef;
    background: #fff
}

.lpFaq__text {
    width: calc(100% - 5rem);
    font-size: 1.6rem;
    font-weight: 500
}

.lpFaq__text--q {
    font-size: 1.8rem;
    font-weight: 700
}

.lpFaq__open {
    color: #1e67ef
}

.lpFaq__body {
    padding: 1.5rem 2rem;
    border-top: 1px solid #d0dcf2;
    background: #edf0f6
}

.lpFaq .md-acc .acc-btn .icon {
    position: absolute;
    top: 50%;
    right: 2rem;
    z-index: 2;
    font-size: 1.4rem;
    transition-duration: .5s;
    transform: translateY(-50%)
}

.lpFaq .md-acc .acc-check:checked ~ .acc-btn .icon {
    transform: translateY(-50%) rotate(180deg)
}

.lpFaq .md-acc .acc-body .acc-in {
    position: relative
}

.lpSignUp {
    padding: 6rem 0 4.5rem;
    background: #edf0f6
}

.lpSignUpHead {
    position: relative
}

.lpSignUpHead__chip {
    position: relative;
    z-index: 2;
    font-size: 1.8rem;
    font-weight: 900;
    line-height: 1.5;
    color: #d03895;
    text-align: center
}

.lpSignUpHead__slash {
    margin: 0 .5rem;
    font-size: 4.7rem;
    transform: translateY(-.1em)
}

.lpSignUpHead__title {
    position: relative;
    z-index: 2;
    margin: 0 0 0 1rem;
