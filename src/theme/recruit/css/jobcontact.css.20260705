}

.contactAddress__list {
    margin: 2rem 0 0
}

.contactAddress__list--zip {
    margin: .5rem 0 0
}

.contactAddress__head {
    padding: 0 2rem;
    width: 15rem;
    font-size: 1.3rem;
    font-weight: 700;
    text-align: right
}

.contactAddress__address, .contactAddress__pref, .contactAddress__zip {
