    padding: 0 0 3rem
}

.topCamp__head, .topCamp__shake, .topCamp__title {
    text-align: center
}

.topCamp__title {
    position: relative;
    z-index: 2;
    margin: 2rem 0 0;
    font-size: 4.9rem;
