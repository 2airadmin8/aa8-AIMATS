    width: 30rem;
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.1
}

.mw_wp_form_confirm .contactTable__th br {
    display: none
}

.mw_wp_form_confirm .contactTable__td {
    width: calc(100% - 30rem)
}

.mw_wp_form_confirm .contactTable__chip {
    display: none
}

.mw_wp_form_confirm .contactTable__check {
    font-size: 1.6rem
}

.contactProfile__tr + .contactProfile__tr {
    border-top: 1px solid #d2d7e1
}

.contactProfile__th {
    padding: 1.8rem 2rem;
    width: 19rem;
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.1
}

.contactProfile__td {
    position: relative;
    padding: 1.8rem 2rem;
    border-left: 1px solid #d2d7e1;
    width: calc(100% - 19rem)
}

.contactProfile__mail, .contactProfile__name, .contactProfile__tel {
