}

#toc_container a {
    display: block;
    color: #727272
}

#toc_container a:hover {
    text-decoration: underline
}

.singleMore {
    position: relative;
    margin: 9rem auto 8.5rem;
    max-width: 60rem
}

.singleMore__text {
    padding: 0 5rem 1rem;
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1
}

.singleMore__img {
    position: absolute;
    right: 5rem;
    bottom: 1rem;
    z-index: 2;
    pointer-events: none
}

.singleMore__btn {
    height: 6.8rem;
    font-size: 1.8rem;
    font-weight: 700
}

.singleRel {
    margin: 9rem 0 0
}

.singleRel__head {
    font-size: 2.4rem;
    line-height: 1
}

.singleRel__list:after, .singleRel__list:before {
    -ms-flex-order: 2;
    order: 2;
    width: 22%;
    content: ""
}

.singleRel__item {
    margin: 1.4rem 0 0;
    width: 22%
}

.singleRel__img {
    border-radius: .8rem
}

.singleRel__title {
    display: -webkit-box;
    margin: .8rem 0 0;
    overflow: hidden;
    font-size: 1.4rem;
    line-height: 1.5;
    color: #383838;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical
}

.singleSns {
    margin: 3rem 0 0
}

.singleSns__item {
    margin: 0 1rem;
    border-radius: .5rem;
    width: 15rem;
    max-width: 32%;
    height: 4rem;
    font-size: 1.3rem;
    color: #fff
}

.singleSns__item:hover {
    opacity: .8
}

.singleSns__item--line {
    border: 1px solid #00b900;
    background: #00b900
}

.singleSns__item--twitter {
    border: 1px solid #1da1f2;
    background: #1da1f2
}

.singleSns__item--facebook {
    border: 1px solid #1778f2;
    background: #1778f2
}

.singleSns__icon {
    margin: 0 1rem 0 0;
    font-size: 2.4rem;
    font-weight: 500;
    line-height: 1
}

.singleSns__icon--twitter {
    font-size: 2rem
}

.singleSns.singleSns--fit {
    position: fixed;
    z-index: 3001;
    margin: 0;
    transition-duration: .5s
}

.pageHead {
    position: relative;
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1
}

.pageHead:before {
    display: inline-block;
    margin: 0 1.5rem 0 0;
    width: 4px;
    height: 1.2em;
    background: #1e67ef;
    content: ""
}

.pageHead--bar {
    padding: 0 0 2rem
}

.pageHead--bar:after {
    position: absolute;
    bottom: 0;
    left: 2rem;
    z-index: 2;
    width: calc(100% - 2rem);
    height: 1px;
    background: #d7d7d7;
    content: ""
}

.pageHead__sub {
    margin: 0 0 0 4rem;
    font-size: 1.4rem;
    font-weight: 400
}

.bread {
    padding: 1rem 0;
    font-size: 1.1rem;
    background: #fffbe5
}

.bread__frame {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: middle
}

.bread .icon, .bread a, .bread span {
    line-height: 1
}

.bread a {
    display: inline-block;
    color: #969595
}

.bread__icon {
    margin: 0 .5rem;
    color: #969595
}

.pageTitle {
    height: 15rem;
    font-size: 3rem;
    font-weight: 700
}

.flex-pager a, .flex-pager span {
    margin: 0 .5rem;
    border-radius: .5rem;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.4rem;
    color: inherit;
    white-space: nowrap;
    background: #fff
}

.flex-pager .active, .flex-pager a:hover {
    border: 1px solid #1e67ef;
    color: #fff;
    text-decoration: none;
    background: #1e67ef
}

.flex-pager .reader {
    border: 0
}

.flex-pager .move {
    border: 1px solid #ccc;
    font-size: 1.2rem
}

.flex-pager .icon {
    pointer-events: none
}

.bookmark {
    border: 1px solid #1e67ef;
    color: #1e67ef;
    background: #fff
}

.bookmark.active {
    border: 1px solid #dfe4e4;
    background: #fafaff
}

.bookmark.active .bookmark__off, .bookmark:not(.active) .bookmark__on {
    display: none
}

.infoBar {
    padding: 1rem 2.5rem;
    border-radius: 1rem;
    height: 7rem;
    font-size: 1.4rem;
    line-height: 1
}

.infoBar--blue {
    border: 1px solid #1e67ef;
    background: #ededff
}

.infoBar--blue .infoBar__icon {
    color: #1e67ef
}

.infoBar--red {
    border: 1px solid #fe6565;
    background: #ffeded
}

.infoBar--red .infoBar__icon {
    color: #fe6565
}

.infoBar__icon {
    margin: 0 1rem 0 0;
    font-size: 2rem
}

.infoBar__head {
    margin: 0 4rem 0 0;
    font-weight: 700
}

.infoBar__text {
    font-weight: 500
}

@media screen and (min-width: 769px) {
    .pc-flex {
        display: -ms-flexbox;
        display: flex
    }

    .flex.pc-bet, .pc-flex.pc-bet {
        -ms-flex-pack: justify;
        justify-content: space-between
    }

    .flex.aro, .flex.pc-aro, .pc-flex.aro, .pc-flex.pc-aro {
        -ms-flex-pack: distribute;
        justify-content: space-around
    }

    .flex.pc-vstart, .pc-flex.pc-vstart {
        -ms-flex-align: start;
        align-items: flex-start
    }

    .flex.pc-vend, .pc-flex.pc-vend {
        -ms-flex-align: end;
        align-items: flex-end
    }

    .flex.pc-vcenter, .pc-flex.pc-vcenter {
        -ms-flex-align: center;
        align-items: center
    }

    .flex.pc-hstart, .pc-flex.pc-hstart {
        -ms-flex-pack: start;
        justify-content: flex-start
    }

    .flex.pc-hcenter, .pc-flex.pc-hcenter {
        -ms-flex-pack: center;
        justify-content: center
    }

    .flex.pc-hend, .pc-flex.pc-hend {
        -ms-flex-pack: end;
        justify-content: flex-end
    }

    .flex.pc-str, .pc-flex.pc-str {
        -ms-flex-align: stretch;
        align-items: stretch
    }

    .flex.pc-vert, .pc-flex.pc-vert {
        -ms-flex-direction: column;
        flex-direction: column
    }

    .flex.pc-vert-wrap, .pc-flex.pc-vert-wrap {
        -ms-writing-mode: tb-lr;
        writing-mode: vertical-lr
    }

    .flex.pc-vert-wrap > *, .pc-flex.pc-vert-wrap > * {
        -ms-writing-mode: lr-tb;
        writing-mode: horizontal-tb
    }

    .flex.pc-break, .pc-flex.pc-break {
        -ms-flex-wrap: wrap;
        flex-wrap: wrap
    }

    .flex > .pc-1, .pc-flex > .pc-1 {
        -ms-flex-order: 1;
        order: 1
    }

    .flex > .pc-2, .pc-flex > .pc-2 {
        -ms-flex-order: 2;
        order: 2
    }

    .flex > .pc-3, .pc-flex > .pc-3 {
        -ms-flex-order: 3;
        order: 3
    }

    .op:hover {
        opacity: .7
    }

    .sp {
        display: none !important
    }

    .pc-hide {
        display: none
    }

    .pc-ta-center {
        text-align: center
    }

    .pc-ta-right {
        text-align: right
    }

    .pc-ta-left {
        text-align: left
    }

    body:not(.wp-admin) #wpadminbar {
        height: 10px !important;
        overflow: hidden !important;
        opacity: .5;
        transition-duration: .5s
    }

    body:not(.wp-admin) #wpadminbar:hover {
        height: auto !important;
        overflow: visible !important;
        opacity: 1
    }

    .md-lay.pc-over {
        display: block
    }

    .md-lay.pc-over .lay-bg img {
        margin-left: 50%;
        width: auto;
        max-width: none;
        transform: translate(-50%)
    }

    .md-lay.pc-through {
        display: inline-block;
        overflow: visible
    }

    .md-lay.pc-through .lay-bg img {
        width: auto;
        max-width: none
    }

    a:hover .md-lay .lay-bg .on {
        opacity: 1
    }

    a:hover .md-lay .lay-bg .off {
        opacity: 0
    }

    a:hover .md-lay.zoom .lay-bg {
        transform: scale(1.05)
    }

    a:hover .md-lay.bright:before {
        opacity: 1
    }

    a:hover .md-lay.border:after {
        box-shadow: inset 0 0 0 10px hsla(0, 0%, 100%, .5);
        opacity: 1
    }

    a:not(:hover) .md-lay.hide .lay-content {
        opacity: 0
    }

    .sp-md-acc .acc-btn {
        cursor: auto
    }

    .wrap {
        margin: 0 auto;
        padding-right: 1rem;
        padding-left: 1rem
    }

    .wrap.w400 {
        max-width: 42rem
    }

    .wrap.w540 {
        max-width: 56rem
    }

    .wrap.w620 {
        max-width: 64rem
    }

    .wrap.w820 {
        max-width: 84rem
    }

    .wrap.w890 {
        max-width: 91rem
    }

    .wrap.w900 {
        max-width: 92rem
    }

    .wrap.w980 {
        max-width: 100rem
    }

    .wrap.w1000 {
        max-width: 102rem
    }

    .wrap.w1040 {
        max-width: 106rem
    }

    .wrap.w1200 {
        max-width: 122rem
    }

    .wrap.w1300 {
        max-width: 132rem
    }

    .wrap.w1450 {
        max-width: 147rem
    }

    .wrap.w1840 {
        max-width: 186rem
    }

    .footerNav__list {
        height: 12rem;
        white-space: nowrap
    }

    .topLogo__item {
        max-width: 7%
    }

    .topLogo__item--wide {
        max-width: 12%
    }

    .topSup .swiper-slide, .topSup .swiper-wrapper {
        display: block
    }

    .side {
        padding: 0 0 1rem;
        width: 24rem
    }

    .side.move {
